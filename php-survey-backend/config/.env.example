SECRET_KEY=your_secret_key_here

APP_NAME=Your App Name
BASE_URL=https://yourdomain.com/index.php
TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com

# These values can be overridden via the Admin UI.
# Stored in php-survey-backend/config/app_settings.json

# Email Sending Mode: 'hosting' or 'smtp'
# - hosting: Send directly from hosting server using PHP mail() function (local sendmail)
# - smtp: Send via external SMTP servers with authentication (supports multiple servers with round-robin)
MAIL_MODE=hosting

# ===== HOSTING MODE CONFIGURATION (ONLY used when MAIL_MODE=hosting) =====
# These variables configure email sending via local sendmail (PHP mail() function)
# All fields are configurable: from address, from name, reply-to address, reply-to name

# From (sender) - who the email appears to come from
HOSTING_FROM_ADDRESS=noreply@yourdomain.com
HOSTING_FROM_NAME=Your App Bot

# Reply-To - where replies should go (optional, defaults to from address if not set)
HOSTING_REPLY_TO_ADDRESS=support@yourdomain.com
HOSTING_REPLY_TO_NAME=Your Support Team

# ===== SMTP MODE CONFIGURATION (ONLY used when MAIL_MODE=smtp) =====
# When MAIL_MODE=smtp, the system IGNORES the HOSTING_* variables above
# Instead, ALL configuration comes from the JSON file:
#   php-survey-backend/config/smtp_mailboxes.json
#
# The admin must manually create this file from smtp_mailboxes.json.example
#
# Features:
# - Connects to external SMTP servers (Gmail, SendGrid, Mailgun, etc.)
# - Supports multiple SMTP servers with round-robin distribution
# - Automatically tracks failed SMTP credentials and skips them
# - Generates smtp_failures.json to flag non-working SMTP credentials
# - Retries failed servers after 1 hour
# - Ensures email sending never fails due to one bad SMTP server
#
# Setup:
# 1. Copy smtp_mailboxes.json.example to smtp_mailboxes.json
# 2. Configure your SMTP server credentials (host, port, username, password, from, reply_to)
# 3. Set MAIL_MODE=smtp
#
# Failure Tracking (automatic):
# The app automatically creates: php-survey-backend/vote_data/smtp_failures.json
# This file tracks which SMTP credentials are not working and should be skipped
# You can delete this file to reset all failure tracking

# ===== VOTE PARAMETERS =====
# Vote parameters are stored in:
#   php-survey-backend/config/vote_params.json
#
# The admin interface will automatically create and manage vote_params.json.

TOKEN_TTL_SECS=3600

# ===== DEBUG MODE =====
# Debug Mode enables development-only features for easier testing:
# 1. Extends session timeout from 5 minutes to 2 hours for all sessions (admin, voter, candidates)
# 2. Shows quick login buttons to bypass email verification (localhost only)
# 3. Allows instant login as admin or voter without needing to check email
#
# Security safeguards:
# - Debug features ONLY work when:
#   a) DEBUG_MODE is set to 'true' AND
#   b) Request is from localhost (127.0.0.1, ::1, or localhost hostname)
# - Production servers will never show debug features even if DEBUG_MODE=true
#
# Usage:
# 1. Set DEBUG_MODE=true in .env
# 2. Make sure localhost is in TRUSTED_HOSTS
# 3. Visit http://localhost:8000 (or your local dev server)
# 4. You'll see a yellow debug panel with quick login buttons
#
# Set to 'true' for development, 'false' for production
DEBUG_MODE=false

TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
